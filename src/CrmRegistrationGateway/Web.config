<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings file="Web.local.config">
    <!-- Secrets stay empty in source control. Azure App Settings or environment
         variables override these values. See README.md for variable names. -->
    <!-- Legacy Altium configuration names used by the reference connection code. -->
    <add key="crmserverurlaltium" value="" />
    <add key="crmuseraltium" value="" />
    <add key="Crm.Url" value="" />
    <add key="Crm.UserKey" value="" />
    <add key="Crm.ClientId" value="" />
    <add key="Crm.ClientSecret" value="" />
    <add key="Crm.TenantId" value="" />
    <add key="Crm.EnvironmentName" value="Test" />
    <add key="Crm.AllowedHost" value="altiumtr-test.crm4.dynamics.com" />
    <add key="Crm.WritesEnabled" value="false" />
    <add key="Crm.InboundApiKey" value="" />
    <!-- Verified TEST Lead field mappings. Azure environment variables override them. -->
    <add key="Crm.TargetEntityLogicalName" value="lead" />
    <add key="Crm.FirstNameAttribute" value="firstname" />
    <add key="Crm.LastNameAttribute" value="lastname" />
    <add key="Crm.EmailAttribute" value="emailaddress1" />
    <add key="Crm.PhoneAttribute" value="mobilephone" />
    <add key="Crm.CompanyAttribute" value="companyname" />
    <!-- Lead profile fields, chosen from current TEST CRM usage (2026-10-05). -->
    <add key="Crm.JobTitleAttribute" value="twbs_isunvani" />
    <add key="Crm.CityLookupAttribute" value="twbs_sehir" />
    <add key="Crm.CityEntityLogicalName" value="twbs_sehir" />
    <add key="Crm.CityNameAttribute" value="twbs_sehiradi" />
    <add key="Crm.KvkkConsentAttribute" value="twbs_kvkkonayi" />
    <!-- İYS: CRM plugins (IYSKontrol, ManuelMkvyOnay) read the business phone. -->
    <add key="Crm.IysPhoneAttribute" value="telephone1" />
    <add key="Crm.IysConsentEnabled" value="true" />
    <add key="Crm.LeadSourceAttribute" value="leadsourcecode" />
    <add key="Crm.DefaultLeadSource" value="CO | Web Formu" />
    <add key="Crm.CampaignLookupAttribute" value="campaignid" />
    <add key="Crm.CampaignEntityLogicalName" value="campaign" />
    <add key="Crm.CampaignNameAttribute" value="name" />
    <!-- Business rule (2026-10-05): web form Leads always get the "Web" source campaign. -->
    <add key="Crm.WebFormCampaign" value="Web" />
    <!-- Business rule (2026-10-06): channel boxes as Evet/Hayır on the Lead. -->
    <add key="Crm.EmailPermissionAttribute" value="altium_epostaizni" />
    <add key="Crm.SmsPermissionAttribute" value="altium_mesajizni" />
    <add key="Crm.CallPermissionAttribute" value="altium_aramaizni" />
    <!-- Public web form endpoint remains closed until these are configured. -->
    <add key="WebLead.AllowedOrigins" value="https://altium.net" />
    <add key="WebLead.TurnstileSecretKey" value="" />
    <!-- Optional widget data-action to require, e.g. web-lead. Empty: not checked. -->
    <add key="WebLead.TurnstileAction" value="" />
    <add key="WebLead.ConsentVersion" value="" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" maxRequestLength="64" executionTimeout="30" />
    <customErrors mode="RemoteOnly" />
  </system.web>
  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
  <!-- Route browser preflight through this page instead of IIS OPTIONSVerbHandler. -->
  <location path="WebLead.aspx">
    <system.webServer>
      <handlers>
        <clear />
        <add name="WebLeadPage" path="WebLead.aspx" verb="*" type="System.Web.UI.PageHandlerFactory" resourceType="Unspecified" preCondition="integratedMode,runtimeVersionv4.0" />
      </handlers>
    </system.webServer>
  </location>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" culture="neutral" publicKeyToken="30ad4fe6b2a6aeed" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" culture="neutral" publicKeyToken="b03f5f7f11d50a3a" />
        <bindingRedirect oldVersion="0.0.0.0-6.0.0.0" newVersion="6.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Text.Json" culture="neutral" publicKeyToken="cc7b13ffcd2ddd51" />
        <bindingRedirect oldVersion="0.0.0.0-6.0.0.10" newVersion="6.0.0.10" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
